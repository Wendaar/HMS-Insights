{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "fra1"
  ],
  "crons": [
    {"path": "/api/cron/pregame-rankings", "schedule": "0 23 * * *"}
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/broadcast", "destination": "/broadcast/index.html", "permanent": false },
    { "source": "/broadcast/", "destination": "/broadcast/index.html", "permanent": false },
    { "source": "/broadcast/sponsors.html", "destination": "/sponsors", "permanent": false },
    { "source": "/sponsors/", "destination": "/sponsors", "permanent": false }
  ],
  "headers": [
    {"source":"/team-comparison/:path*","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; img-src 'self' blob: https://prod-hms-wootera.s3.eu-central-1.amazonaws.com https://hockeymanagementsystem.s3.amazonaws.com; base-uri 'none'; form-action 'self'; frame-ancestors *"}]},
    {"source":"/sponsors","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/all-stars/:path*","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; img-src 'self' blob:; base-uri 'none'; form-action 'self'; frame-ancestors *"}]},
    {"source":"/operations/:path*","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Cache-Control","value":"no-store"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}]},
    {
      "source": "/game-center",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' https://prod-hms-wootera.s3.eu-central-1.amazonaws.com https://hockeymanagementsystem.s3.amazonaws.com; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
      ]
    },
    {
      "source": "/games/:path*",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' https://prod-hms-wootera.s3.eu-central-1.amazonaws.com https://hockeymanagementsystem.s3.amazonaws.com; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
      ]
    },
    {
      "source": "/broadcast/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/control/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; font-src 'self'; img-src 'self' https:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/tools/playoff-players/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' https:; base-uri 'none'; form-action 'self'; frame-ancestors *" }
      ]
    }
  ],
  "rewrites": [
    {"source":"/api/team-comparison","destination":"/api/game-summary?view=team-comparison"},
    {"source":"/control/apps/team-comparison","destination":"/team-comparison/index.html"},
    {"source":"/team-comparison/:org([a-z0-9-]+)","destination":"/team-comparison/index.html"},
    { "source": "/sponsors", "destination": "/broadcast/sponsors.html" },
    {"source":"/api/all-stars","destination":"/api/game-summary?view=all-stars"},
    {"source":"/control/apps/all-stars","destination":"/all-stars/index.html"},
    {"source":"/all-stars/:org([a-z0-9-]+)/:instance([a-z0-9-]+)","destination":"/all-stars/index.html"},
    {"source":"/all-stars/:org([a-z0-9-]+)","destination":"/all-stars/index.html"},
    {"source":"/operations","destination":"/operations/index.html"},
    {"source":"/operations/","destination":"/operations/index.html"},
    {"source":"/api/operations","destination":"/api/game-summary?view=operations"},
    { "source": "/games/:org([a-z0-9-]+)/:competition([a-z0-9-]+)/:season([a-z0-9-]+)", "destination": "/games/index.html" },
    { "source": "/games/:org([a-z0-9-]+)/:season([a-z0-9-]+)", "destination": "/games/index.html" },
    { "source": "/game-center", "destination": "/games/index.html" },
    { "source": "/game-center/", "destination": "/games/index.html" },
    { "source": "/api/games", "destination": "/api/game-summary?view=games" },
    { "source": "/api/broadcast", "destination": "/api/game-summary?view=broadcast" },
    { "source": "/api/cron/pregame-rankings", "destination": "/api/game-summary?view=pregame-rankings" },
    { "source": "/api/tools", "destination": "/api/game-summary?view=tools" },
    { "source": "/control/apps/playoff-players", "destination": "/tools/playoff-players/index.html" },
    { "source": "/tools/playoff-players", "destination": "/tools/playoff-players/index.html" },
    { "source": "/tools/playoff-players/:org([a-z0-9-]+)/:instance([a-z0-9-]+)", "destination": "/tools/playoff-players/index.html" },
    { "source": "/control", "destination": "/control/index.html" },
    { "source": "/control/", "destination": "/control/index.html" },
    {
      "source": "/api/studio-image",
      "destination": "/api/game-summary?view=studio-image"
    },
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    },
    {
      "source": "/studio/:org([a-zA-Z0-9-]+)",
      "destination": "/studio/index.html"
    },
    {
      "source": "/api/webhooks/hms/org/:org([a-zA-Z0-9-]+)",
      "destination": "/api/webhooks/hms/game-finished?org=:org"
    },
    {
      "source": "/api/studio",
      "destination": "/api/game-summary?view=studio"
    },
    {
      "source": "/api/player-card",
      "destination": "/api/game-summary?view=player-card"
    },
    {
      "source": "/game-center/:gameId/public",
      "destination": "/api/game-report-page?gameId=:gameId"
    },
    {
      "source": "/game-center/:gameId",
      "destination": "/api/game-report-page?gameId=:gameId"
    },
    {
      "source": "/",
      "destination": "/api/page?feedOrg=PHM"
    },
    {
      "source": "/priklepy/:org([a-zA-Z0-9-]+)",
      "destination": "/api/page?feedOrg=:org"
    },
    {
      "source": "/archiv/:org([a-zA-Z0-9-]+)",
      "destination": "/api/archive-page?feedOrg=:org"
    },
    {
      "source": "/priklepy",
      "destination": "/api/page?feedOrg=PHM"
    },
    {
      "source": "/archiv",
      "destination": "/api/archive-page?feedOrg=PHM"
    },
    {
      "source": "/admin/import-game",
      "destination": "/api/import-game-page"
    },
    {
      "source": "/admin/backfill",
      "destination": "/api/backfill-page"
    }
  ]
}
