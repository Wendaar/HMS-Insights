{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/control/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/control", "destination": "/control/index.html" },
    { "source": "/control/", "destination": "/control/index.html" },
    {
      "source": "/api/studio-image",
      "destination": "/api/game-summary?view=studio-image"
    },
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    },
    {
      "source": "/studio/:org([a-zA-Z0-9-]+)",
      "destination": "/studio/index.html"
    },
    {
      "source": "/api/webhooks/hms/org/:org([a-zA-Z0-9-]+)",
      "destination": "/api/webhooks/hms/game-finished?org=:org"
    },
    {
      "source": "/api/studio",
      "destination": "/api/game-summary?view=studio"
    },
    {
      "source": "/api/player-card",
      "destination": "/api/game-summary?view=player-card"
    },
    {
      "source": "/game-center/:gameId/public",
      "destination": "/api/game-report-page?gameId=:gameId"
    },
    {
      "source": "/game-center/:gameId",
      "destination": "/api/game-report-page?gameId=:gameId"
    },
    {
      "source": "/",
      "destination": "/api/page?feedOrg=PHM"
    },
    {
      "source": "/priklepy/:org([a-zA-Z0-9-]+)",
      "destination": "/api/page?feedOrg=:org"
    },
    {
      "source": "/archiv/:org([a-zA-Z0-9-]+)",
      "destination": "/api/archive-page?feedOrg=:org"
    },
    {
      "source": "/priklepy",
      "destination": "/api/page?feedOrg=PHM"
    },
    {
      "source": "/archiv",
      "destination": "/api/archive-page?feedOrg=PHM"
    },
    {
      "source": "/admin/import-game",
      "destination": "/api/import-game-page"
    },
    {
      "source": "/admin/backfill",
      "destination": "/api/backfill-page"
    }
  ]
}
