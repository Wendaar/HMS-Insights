{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["fra1"],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/page" },
    { "source": "/priklepy", "destination": "/api/page" },
    { "source": "/archiv", "destination": "/api/archive-page" },
    { "source": "/admin/import-game", "destination": "/api/import-game-page" },
    { "source": "/admin/backfill", "destination": "/api/backfill-page" }
  ]
}
