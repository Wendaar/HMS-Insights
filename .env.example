# PostgreSQL provisioned through Vercel Marketplace (Neon recommended).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# HMS server-to-server access. Wootera will provide the real values.
HMS_API_TOKEN=replace-in-vercel-never-commit
# Optional override. Production HMS v1 is used automatically when omitted.
HMS_API_BASE_URL=https://public-api.prod.hms.wootera.net/api/v1

# A separate secret used only to authenticate game.finished notifications.
HMS_WEBHOOK_SECRET=generate-a-long-random-value-in-vercel

# Optional while the live database is not connected. Never enable in production.
ALLOW_DEMO_FEED=true

# Legacy prototype persistence; no longer required by the Vercel path.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-locally-never-commit
PORT=3000


# Media Studio: optional server-only organization connections. No public editor writes.
# PHM defaults to the repository's existing PHM identity and HMS_API_TOKEN.
# For each of EUCHL, YHG, BNHLH configure HMS_<ORG>_ORGANIZATION_ID
# and optionally HMS_<ORG>_API_TOKEN in the hosting environment.
# Unconfigured/mismatched organizations fail closed. See docs/MEDIA-STUDIO.md.
